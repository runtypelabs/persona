    "@ui-sdk/web": "0.1.0-beta.1",
    "alasql": "^4.22.0",
    "echarts": "^6.1.0",
    "flint-chart": "^1.0.1",
    "handlebars": "^4.7.10",
    "idiomorph": "^0.8.0",
    "jspaint": "github:runtypelabs/jspaint#61814a33efbd2021859caf37381f1005dfc25666",
    "modern-screenshot": "^4.7.0",
    "partial-json": "^0.1.7",
