{
  "name": "runtype-hono-proxy",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/node.ts",
    "dev:workers": "wrangler dev",
    "deploy:workers": "wrangler deploy",
    "start": "node dist/node.js",
    "build": "tsdown src/node.ts --format esm,cjs --dts --no-fixed-extension --out-dir dist",
    "types-check": "tsc --noEmit",
    "test": "tsx --test src/request-guard.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.10",
    "@runtypelabs/persona-proxy": "workspace:^",
    "dotenv": "^16.4.5",
    "get-port": "^7.2.0",
    "hono": "^4.12.25"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260612.1",
    "@types/node": "^20.12.7",
    "tsdown": "^0.23.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "wrangler": "^4.100.0"
  }
}
