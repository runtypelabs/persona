# Preview is the default. No credentials or Eve runtime are needed.
EVE_MODE=preview

# To run the bundled live agent, set EVE_MODE=live and add a Gateway key.
# withEve starts the agent beside Next.js. Restart after changing modes.
AI_GATEWAY_API_KEY=

# Optional: use an existing authenticated Eve server instead of the bundled one.
# EVE_BASE_URL=https://your-eve-server.example
# EVE_BEARER_TOKEN=
