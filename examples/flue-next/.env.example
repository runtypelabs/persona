# Preview works without any environment variables.
# For Live mode, use this in .env.local and matching values in agent/.env.
FLUE_AGENT_URL=http://127.0.0.1:3301/agents/releases
FLUE_TOKEN=replace-with-a-long-random-secret
# These provider settings are needed only in agent/.env.
OPENAI_API_KEY=
FLUE_MODEL=openai/gpt-5.5
