{
  "name": "@runtypelabs/persona-proxy",
  "version": "4.29.2",
  "description": "Proxy server for @runtypelabs/persona widget - handles flow configuration and forwards requests to AI backends.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint",
    "typecheck": "node ../../scripts/typecheck.mjs --noEmit",
    "test:run": "vitest run"
  },
  "dependencies": {
    "hono": "^4.12.25"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "rimraf": "^5.0.5",
    "tsdown": "^0.23.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "author": "Runtype",
  "license": "MIT",
  "keywords": [
    "ai",
    "proxy",
    "server",
    "persona",
    "chat",
    "typescript",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runtypelabs/persona.git",
    "directory": "packages/proxy"
  },
  "bugs": {
    "url": "https://github.com/runtypelabs/persona/issues"
  },
  "homepage": "https://github.com/runtypelabs/persona/tree/main/packages/proxy#readme",
  "publishConfig": {
    "access": "public"
  }
}
